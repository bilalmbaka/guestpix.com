 color:#072A47;\n  margin-bottom:10px;\n}\n@media(max-width:520px){.gpx-hg h2{font-size:30px}}\n.gpx-hg .gpx-sub{\n  font-size:16px;\n  color:#6b6b68;\n  margin-bottom:36px;\n  line-height:1.6;\n}\n\n\/* Form *\/\n.gpx-hg .gpx-form{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:16px;\n  margin-bottom:4px;\n}\n@media(max-width:520px){.gpx-hg .gpx-form{grid-template-columns:1fr}}\n.gpx-hg .gpx-field{display:flex;flex-direction:column;gap:7px}\n.gpx-hg .gpx-field.gpx-full{grid-column:1\/-1}\n.gpx-hg label{\n  font-size:11px;\n  font-weight:600;\n  letter-spacing:1.5px;\n  text-transform:uppercase;\n  color:#5a5a57;\n}\n.gpx-hg .gpx-opt{\n  font-weight:400;\n  text-transform:none;\n  letter-spacing:0;\n  color:#b0afa8;\n}\n.gpx-hg input{\n  border:1.5px solid #e8e5e0;\n  border-radius:10px;\n  padding:13px 16px;\n  font-family:'DM Sans',sans-serif;\n  font-size:15px;\n  color:#072A47;\n  background:#fdfcfb;\n  transition:border-color 0.2s,box-shadow 0.2s;\n  outline:none;\n  width:100%;\n}\n.gpx-hg input:focus{\n  border-color:#EB8783;\n  box-shadow:0 0 0 3px rgba(235,135,131,0.12);\n  background:#fff;\n}\n.gpx-hg input::placeholder{color:#c8c6bf}\n\n\/* Generate button *\/\n.gpx-hg .gpx-btn{\n  grid-column:1\/-1;\n  background:#EB8783;\n  color:#fff;\n  border:none;\n  border-radius:10px;\n  padding:16px 28px;\n  font-family:'DM Sans',sans-serif;\n  font-size:15px;\n  font-weight:600;\n  letter-spacing:0.2px;\n  cursor:pointer;\n  transition:background 0.15s,transform 0.1s,box-shadow 0.15s;\n  width:100%;\n  margin-top:4px;\n}\n.gpx-hg .gpx-btn:hover{\n  background:#d9706c;\n  box-shadow:0 4px 16px rgba(235,135,131,0.35);\n}\n.gpx-hg .gpx-btn:active{transform:scale(0.99)}\n\n\/* Results *\/\n.gpx-hg .gpx-results{margin-top:36px;display:none}\n.gpx-hg .gpx-results.show{display:block}\n\n.gpx-hg .gpx-results-header{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  margin-bottom:20px;\n}\n.gpx-hg .gpx-results-label{\n  font-size:11px;\n  font-weight:600;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  color:#EB8783;\n}\n.gpx-hg .gpx-results-rule{\n  flex:1;\n  height:1px;\n  background:linear-gradient(to right,#f0dedd,transparent);\n}\n\n\/* Category label *\/\n.gpx-hg .gpx-cat{\n  font-size:11px;\n  font-weight:600;\n  letter-spacing:1.5px;\n  text-transform:uppercase;\n  color:#c8a09e;\n  margin:22px 0 10px;\n}\n.gpx-hg .gpx-cat:first-child{margin-top:0}\n\n\/* Hashtag pills *\/\n.gpx-hg .gpx-tags{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:4px}\n.gpx-hg .gpx-tag{\n  display:flex;\n  align-items:center;\n  gap:8px;\n  background:#fff;\n  border:1.5px solid #eddedd;\n  border-radius:100px;\n  padding:10px 18px;\n  font-family:'Cormorant Garamond',serif;\n  font-size:17px;\n  font-weight:600;\n  color:#072A47;\n  cursor:pointer;\n  transition:all 0.18s;\n  user-select:none;\n}\n.gpx-hg .gpx-tag:hover{\n  background:#fdf5f5;\n  border-color:#EB8783;\n  color:#EB8783;\n}\n.gpx-hg .gpx-tag .gpx-ci{\n  font-family:'DM Sans',sans-serif;\n  font-size:11px;\n  font-weight:500;\n  color:#d4b0ae;\n  flex-shrink:0;\n  letter-spacing:0.5px;\n}\n.gpx-hg .gpx-tag:hover .gpx-ci{color:#EB8783}\n.gpx-hg .gpx-tag.copied{\n  background:#fdf5f5;\n  border-color:#EB8783;\n  color:#EB8783;\n}\n.gpx-hg .gpx-tag.copied .gpx-ci{color:#EB8783}\n\n\/* Fun fact *\/\n.gpx-hg .gpx-fact{\n  background:#fdf8f7;\n  border-left:3px solid #EB8783;\n  border-radius:0 10px 10px 0;\n  padding:16px 20px;\n  margin:28px 0;\n  font-size:14px;\n  color:#5a5a57;\n}\n.gpx-hg .gpx-fact strong{\n  display:block;\n  font-family:'DM Sans',sans-serif;\n  font-size:10px;\n  font-weight:700;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  color:#072A47;\n  margin-bottom:5px;\n}\n\n\/* Divider *\/\n.gpx-hg .gpx-divider{\n  border:none;\n  height:1px;\n  background:linear-gradient(to right,#f0dedd,#f5f0ee,transparent);\n  margin:28px 0;\n}\n\n\/* CTA box *\/\n.gpx-hg .gpx-cta{\n  background:linear-gradient(135deg,#fff8f8 0%,#fdf4f0 100%);\n  border:1.5px solid #f0dedd;\n  border-radius:16px;\n  padding:28px;\n  text-align:center;\n}\n.gpx-hg .gpx-cta-icon{\n  font-family:'Cormorant Garamond',serif;\n  font-size:28px;\n  margin-bottom:10px;\n  display:block;\n  color:#EB8783;\n}\n.gpx-hg .gpx-cta-title{\n  font-family:'Cormorant Garamond',serif;\n  font-size:22px;\n  font-weight:600;\n  color:#072A47;\n  margin-bottom:8px;\n  line-height:1.3;\n}\n.gpx-hg .gpx-cta p{\n  font-size:14px;\n  color:#6b6b68;\n  margin-bottom:20px;\n  line-height:1.6;\n}\n.gpx-hg .gpx-cta a{\n  display:inline-block;\n  background:#072A47;\n  color:#fff;\n  text-decoration:none;\n  border-radius:10px;\n  padding:14px 32px;\n  font-family:'DM Sans',sans-serif;\n  font-size:14px;\n  font-weight:600;\n  letter-spacing:0.3px;\n  transition:background 0.15s,box-shadow 0.15s;\n}\n.gpx-hg .gpx-cta a:hover{\n  background:#051830;\n  box-shadow:0 4px 16px rgba(22,32,64,0.25);\n  color:#fff;\n}\n.gpx-hg .gpx-cta .gpx-cta-note{\n  display:block;\n  font-size:12px;\n  color:#b0afa8;\n  margin-top:10px;\n  letter-spacing:0.3px;\n}\n<\/style>\n\n<div class=\"gpx-hg\">\n  <p class=\"gpx-eyebrow\">Free tool by GUESTPIX\u2122<\/p>\n  <h2>Wedding Hashtag Generator<\/h2>\n  <p class=\"gpx-sub\">Enter your details and we'll create personalised hashtags for your big day. Click any to copy instantly.<\/p>\n\n  <div class=\"gpx-form\">\n    <div class=\"gpx-field\">\n      <label for=\"gpx-n1\">Partner 1 first name<\/label>\n      <input type=\"text\" id=\"gpx-n1\" placeholder=\"e.g. Sarah\" autocomplete=\"off\">\n    <\/div>\n    <div class=\"gpx-field\">\n      <label for=\"gpx-n2\">Partner 2 first name<\/label>\n      <input type=\"text\" id=\"gpx-n2\" placeholder=\"e.g. James\" autocomplete=\"off\">\n    <\/div>\n    <div class=\"gpx-field\">\n      <label for=\"gpx-sn\">Shared surname <span class=\"gpx-opt\">(optional)<\/span><\/label>\n      <input type=\"text\" id=\"gpx-sn\" placeholder=\"e.g. Thompson\" autocomplete=\"off\">\n    <\/div>\n    <div class=\"gpx-field\">\n      <label for=\"gpx-yr\">Wedding year <span class=\"gpx-opt\">(optional)<\/span><\/label>\n      <input type=\"text\" id=\"gpx-yr\" placeholder=\"e.g. 2025\" maxlength=\"4\" autocomplete=\"off\">\n    <\/div>\n    <div class=\"gpx-field gpx-full\">\n      <label for=\"gpx-city\">Wedding city or location <span class=\"gpx-opt\">(optional)<\/span><\/label>\n      <input type=\"text\" id=\"gpx-city\" placeholder=\"e.g. Nashville, Tuscany, The Cotswolds, Santorini\u2026\" autocomplete=\"off\">\n    <\/div>\n    <button class=\"gpx-btn\" onclick=\"gpxGen()\">Generate My Hashtags<\/button>\n  <\/div>\n\n  <div class=\"gpx-results\" id=\"gpx-results\">\n    <div class=\"gpx-results-header\">\n      <span class=\"gpx-results-label\">Your hashtags<\/span>\n      <span class=\"gpx-results-rule\"><\/span>\n    <\/div>\n    <div id=\"gpx-out\"><\/div>\n    <div class=\"gpx-fact\" id=\"gpx-fact\"><\/div>\n    <hr class=\"gpx-divider\">\n    <div class=\"gpx-cta\">\n      <span class=\"gpx-cta-icon\">&#9825;<\/span>\n      <p class=\"gpx-cta-title\">Now let your guests capture the memories too.<\/p>\n      <p>No app, no registration \u2014 guests simply scan your GUESTPIX\u2122 QR code and upload photos instantly. Because it only happens once.<\/p>\n      <a href=\"https:\/\/guestpix.com\/free-photo-sharing-app\">Get Started Free<\/a>\n      <span class=\"gpx-cta-note\">No credit card needed &nbsp;\u00b7&nbsp; 2 mins to set up<\/span>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n(function(){\n\nvar FACTS=[\n  {l:'Did you know?',t:'The average wedding guest takes over 20 photos on the day \u2014 most never make it to the couple.'},\n  {l:'Did you know?',t:'Something borrowed is said to bring good luck by lending the bride happiness from a happily married woman.'},\n  {l:'Did you know?',t:'The tradition of a wedding cake dates back to ancient Rome, where grain was broken over the bride\\'s head for good fortune.'},\n  {l:'Did you know?',t:'June remains one of the most popular wedding months \u2014 named after Juno, the Roman goddess of marriage.'},\n  {l:'Did you know?',t:'The average couple invites 167 guests to their wedding. That\\'s a lot of cameras pointed your way.'},\n  {l:'Did you know?',t:'Wedding hashtags became mainstream around 2012, shortly after Instagram launched web profiles.'},\n  {l:'Did you know?',t:'White wedding dresses only became popular after Queen Victoria wore one in 1840. Before that, brides wore their best dress in any colour.'},\n  {l:'Did you know?',t:'\"Something blue\" represents fidelity \u2014 it was the colour of purity in ancient Israel, predating white by centuries.'},\n  {l:'Did you know?',t:'Confetti originates from Italy \u2014 the word means \"sweets,\" which were originally thrown at weddings to symbolise prosperity.'},\n  {l:'Did you know?',t:'The first recorded use of a wedding ring dates back 3,000 years to ancient Egypt, made from braided reeds.'},\n  {l:'Fun fact',t:'Flowers represent 8\u201310% of the average wedding budget \u2014 the same as photography.'},\n  {l:'Fun fact',t:'Diamond engagement rings became a Western tradition largely through a De Beers marketing campaign launched in 1947.'},\n  {l:'Fun fact',t:'The word \"wedding\" comes from the Anglo-Saxon \"wedd\" \u2014 meaning a pledge or bet.'},\n  {l:'Fun fact',t:'In many cultures, the groom traditionally carries the bride over the threshold to protect her from evil spirits lurking below.'},\n  {l:'GUESTPIX\u2122 fact',t:'Over 150,000 couples and event hosts worldwide have used GUESTPIX\u2122 to collect guest photos \u2014 no app download required, just a QR code.'},\n];\n\nfunction clean(s){return(s||'').trim().replace(\/[^a-zA-Z0-9]\/g,'')}\nfunction cap(s){return s?s[0].toUpperCase()+s.slice(1).toLowerCase():''}\nfunction capCity(s){return s.trim().split(\/\\s+\/).map(function(w){return w[0].toUpperCase()+w.slice(1)}).join('')}\nfunction porto(a,b){\n  a=a.toLowerCase();b=b.toLowerCase();\n  var h=Math.ceil(a.length\/2);\n  return cap(a.slice(0,h))+cap(b.slice(Math.floor(b.length\/2)));\n}\n\nwindow.gpxGen=function(){\n  var n1=clean(document.getElementById('gpx-n1').value);\n  var n2=clean(document.getElementById('gpx-n2').value);\n  var sn=clean(document.getElementById('gpx-sn').value);\n  var yr=clean(document.getElementById('gpx-yr').value);\n  var cityRaw=(document.getElementById('gpx-city').value||'').trim();\n  var city=cityRaw?capCity(cityRaw.replace(\/[^a-zA-Z0-9\\s]\/g,'')):'';\n\n  if(!n1||!n2){alert('Please enter both names to get started.');return;}\n\n  var N1=cap(n1),N2=cap(n2),SN=cap(sn),Y=yr,P=porto(n1,n2);\n\n  var classic=[],romantic=[],fun=[],bySurname=[],byLocation=[];\n\n  \/\/ Classic\n  classic.push('#'+N1+'And'+N2);\n  classic.push('#'+N2+'And'+N1);\n  if(Y){classic.push('#'+N1+N2+Y);classic.push('#'+N2+N1+Y);}\n  classic.push('#'+N1+'Weds'+N2);\n  if(SN){classic.push('#'+SN+'Wedding');if(Y)classic.push('#'+SN+'Wedding'+Y);}\n  if(Y)classic.push('#'+N1+'And'+N2+Y);\n\n  \/\/ Romantic\n  romantic.push('#'+N1+N2+'Forever');\n  romantic.push('#ForeverAnd'+N1+N2);\n  romantic.push('#'+N1+'Loves'+N2);\n  romantic.push('#'+N1+N2+'TiedTheKnot');\n  romantic.push('#HappilyEverAfter'+N1+N2);\n  if(SN){romantic.push('#MrAndMrs'+SN);romantic.push('#Forever'+SN);}\n  if(Y)romantic.push('#'+N1+N2+'HappilyEver'+Y);\n\n  \/\/ Fun\n  fun.push('#'+P+'Wedding');\n  if(Y)fun.push('#'+P+Y);\n  fun.push('#'+N1+'Said'+N2+'Do');\n  fun.push('#'+N2+'Found'+N1);\n  fun.push('#From'+N2+'WithLove');\n  fun.push('#'+N1+N2+'TookThePlunge');\n  if(Y)fun.push('#Married'+Y);\n  fun.push('#'+N1+N2+'GotHitched');\n  fun.push('#TwoBecome'+N1+N2);\n\n  \/\/ Surname\n  if(SN){\n    bySurname.push('#The'+SN+'s');\n    bySurname.push('#'+SN+'Nuptials');\n    bySurname.push('#Team'+SN);\n    bySurname.push('#'+SN+'WeddingDay');\n    bySurname.push('#'+SN+'Crew');\n    if(Y)bySurname.push('#The'+SN+'s'+Y);\n    bySurname.push('#GetTo'+SN+'Know'+N1+N2);\n  }\n\n  \/\/ Location\n  if(city){\n    byLocation.push('#'+N1+'And'+N2+'In'+city);\n    byLocation.push('#'+N2+'And'+N1+'In'+city);\n    byLocation.push('#WeddingIn'+city);\n    byLocation.push('#'+city+'Wedding');\n    if(Y)byLocation.push('#'+city+'Wedding'+Y);\n    if(SN)byLocation.push('#The'+SN+'sIn'+city);\n    byLocation.push('#'+P+'In'+city);\n    if(Y)byLocation.push('#'+N1+N2+city+Y);\n    byLocation.push('#'+N1+N2+city);\n  }\n\n  function renderGroup(label,tags,limit){\n    if(!tags.length)return'';\n    var html='<p class=\"gpx-cat\">'+label+'<\/p><div class=\"gpx-tags\">';\n    tags.slice(0,limit||6).forEach(function(t){\n      var safe=t.replace(\/'\/g,\"\\\\'\");\n      html+='<div class=\"gpx-tag\" onclick=\"gpxCopy(this,\\''+safe+'\\')\">'+t+' <span class=\"gpx-ci\">copy<\/span><\/div>';\n    });\n    return html+'<\/div>';\n  }\n\n  var html='';\n  html+=renderGroup('Classic',classic,5);\n  html+=renderGroup('Romantic',romantic,5);\n  html+=renderGroup('Fun &amp; playful',fun,5);\n  if(bySurname.length)html+=renderGroup('Surname-based',bySurname,5);\n  if(byLocation.length)html+=renderGroup('Location &mdash; '+cityRaw,byLocation,6);\n\n  document.getElementById('gpx-out').innerHTML=html;\n\n  \/\/ Fact \u2014 GUESTPIX stat ~1 in 5\n  var pick=Math.random()<0.2?FACTS[FACTS.length-1]:FACTS[Math.floor(Math.random()*(FACTS.length-1))];\n  document.getElementById('gpx-fact').innerHTML='<strong>'+pick.l+'<\/strong>'+pick.t;\n\n  var r=document.getElementById('gpx-results');\n  r.classList.add('show');\n  r.scrollIntoView({behavior:'smooth',block:'nearest'});\n};\n\nwindow.gpxCopy=function(el,text){\n  (navigator.clipboard?navigator.clipboard.writeText(text):Promise.reject()).catch(function(){\n    var ta=document.createElement('textarea');\n    ta.value=text;ta.style.cssText='position:fixed;opacity:0';\n    document.body.appendChild(ta);ta.select();document.execCommand('copy');\n    document.body.removeChild(ta);\n  });\n  el.classList.add('copied');\n  el.querySelector('.gpx-c